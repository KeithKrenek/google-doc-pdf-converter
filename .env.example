# Google Cloud Configuration
PROJECT_ID=your-project-id
REGION=us-central1
BUCKET_NAME=your-project-id-pdf-assets

# Google Service Account Credentials
# For Cloud Run deployment, use Secret Manager (recommended)
# For local development, use base64 encoded JSON or file path
GOOGLE_CREDENTIALS_JSON=your-base64-encoded-service-account-json

# OR for local development only:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Application Configuration
PORT=8080
LOG_LEVEL=INFO

# Optional: Custom styling (future use)
# CUSTOM_FONT_FAMILY=Helvetica
# CUSTOM_PRIMARY_COLOR=#2c3e50
